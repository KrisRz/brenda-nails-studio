---
export interface Props {
  title: string
  description?: string
}

const { title, description = 'Brenda Nails Studio - Professional nail art and beauty services' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Luxury Typography - Award-winning Industry Standard -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
    
    <!-- Brenda Nails Chatbot -->
    <link rel="stylesheet" href="/chatbot/chatbot.css">
    <div id="bn-chatbot"></div>
    <script src="/chatbot/chatbot.js" defer></script>
    
    <!-- Black preloader fix -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Add loaded class after a short delay to ensure smooth transition
        setTimeout(() => {
          document.body.classList.add('loaded');
        }, 100);
      });
      
      // Fallback for window load event
      window.addEventListener('load', function() {
        document.body.classList.add('loaded');
      });
    </script>
  </body>
  <style is:global>
    @import '../styles/globals.css';
  </style>
</html>
